<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f0f4f8">

    <!-- Custom Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#ffffff"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="THREATMIND"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0d1117"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SECURITY v1.0"
            android:textSize="10sp"
            android:textColor="#5a6a7a"
            android:fontFamily="monospace"/>

    </LinearLayout>

    <!-- Thin header border -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#c8d4de"/>

    <!-- Content Pages (switched by bottom nav) -->

    <!-- SCAN PAGE -->
    <LinearLayout
        android:id="@+id/pageScan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Status Banner -->
        <LinearLayout
            android:id="@+id/statusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#00875a"
            android:padding="24dp"
            android:gravity="center"
            android:layout_margin="16dp">

            <TextView
                android:id="@+id/txtStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAP TO SCAN YOUR DEVICE"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:gravity="center"/>

            <TextView
                android:id="@+id/txtStatusSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.6M signatures ready"
                android:textSize="11sp"
                android:textColor="#ccffffff"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp"
                android:gravity="center"/>

            <View
                android:id="@+id/scanProgressBar"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="14dp"
                android:background="#ffffff"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_white"
                android:padding="14dp"
                android:gravity="center"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/txtStatFiles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#00875a"
                    android:fontFamily="monospace"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FILES SCANNED"
                    android:textSize="8sp"
                    android:textColor="#5a6a7a"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_white"
                android:padding="14dp"
                android:gravity="center"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp">
                <TextView
                    android:id="@+id/txtStatSigs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.6M"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#0066cc"
                    android:fontFamily="monospace"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIGNATURES"
                    android:textSize="8sp"
                    android:textColor="#5a6a7a"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_white"
                android:padding="14dp"
                android:gravity="center"
                android:layout_marginStart="6dp">
                <TextView
                    android:id="@+id/txtStatThreats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#cc1f3a"
                    android:fontFamily="monospace"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THREATS"
                    android:textSize="8sp"
                    android:textColor="#5a6a7a"
                    android:fontFamily="monospace"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Last Scan -->
        <TextView
            android:id="@+id/txtLastScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="10sp"
            android:textColor="#8a9baa"
            android:gravity="center"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <!-- Log Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SCAN LOG"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#5a6a7a"
            android:fontFamily="monospace"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="4dp"/>

        <!-- Log Output -->
        <TextView
            android:id="@+id/txtLogOutput"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_white"
            android:padding="14dp"
            android:textSize="11sp"
            android:textColor="#0d1117"
            android:fontFamily="monospace"
            android:scrollbars="vertical"
            android:maxLines="300"
            android:gravity="bottom"/>

    </LinearLayout>

    <!-- QUARANTINE PAGE -->
    <ScrollView
        android:id="@+id/pageQuarantine"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QUARANTINE"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0d1117"
                android:fontFamily="monospace"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Files flagged during scanning"
                android:textSize="11sp"
                android:textColor="#5a6a7a"
                android:fontFamily="monospace"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:id="@+id/threatListCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_danger_white"
                android:layout_marginBottom="12dp"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THREATS DETECTED"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#cc1f3a"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:id="@+id/threatListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/quarantineEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                android:background="@drawable/card_white">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textSize="48sp"
                    android:textColor="#00875a"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No threats in quarantine"
                    android:textSize="14sp"
                    android:textColor="#5a6a7a"
                    android:gravity="center"
                    android:fontFamily="monospace"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Run a scan to check your device"
                    android:textSize="10sp"
                    android:textColor="#8a9baa"
                    android:gravity="center"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- SETTINGS PAGE -->
    <ScrollView
        android:id="@+id/pageSettings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SETTINGS"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0d1117"
                android:fontFamily="monospace"
                android:layout_marginBottom="16dp"/>

            <!-- Section: Scan -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SCAN DATABASE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#0066cc"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/txtDbStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Loading..."
                    android:textSize="12sp"
                    android:textColor="#00875a"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnUpdateDatabase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UPDATE DATABASES"
                    android:textSize="11sp"
                    android:textColor="#ffffff"
                    android:backgroundTint="#0066cc"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#c8d4de"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Extended database (~200MB)"
                        android:textSize="12sp"
                        android:textColor="#0d1117"
                        android:fontFamily="monospace"/>
                    <Switch
                        android:id="@+id/switchExtended"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Link / domain scanner"
                        android:textSize="12sp"
                        android:textColor="#0d1117"
                        android:fontFamily="monospace"/>
                    <Switch
                        android:id="@+id/switchLinkScanner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Section: Protection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PROTECTION"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#0066cc"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Realtime scanner"
                        android:textSize="12sp"
                        android:textColor="#0d1117"
                        android:fontFamily="monospace"/>
                    <Switch
                        android:id="@+id/switchRealtime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Download over Tor (requires Orbot)"
                        android:textSize="12sp"
                        android:textColor="#0d1117"
                        android:fontFamily="monospace"/>
                    <Switch
                        android:id="@+id/switchTor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Section: Advanced -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ADVANCED"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#0066cc"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Database server URL"
                    android:textSize="11sp"
                    android:textColor="#5a6a7a"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/editDbServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:inputType="textUri"
                    android:background="@drawable/input_bg"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#c8d4de"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Database signing key"
                    android:textSize="11sp"
                    android:textColor="#5a6a7a"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/editSigningKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:inputType="text"
                    android:background="@drawable/input_bg"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnSaveAdvanced"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAVE"
                    android:textSize="11sp"
                    android:textColor="#ffffff"
                    android:backgroundTint="#0d1117"
                    android:fontFamily="monospace"/>

            </LinearLayout>

            <!-- Section: About -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white"
                android:padding="16dp"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ThreatMind AV v1.0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0d1117"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Powered by ClamAV signatures · MaintainTeam DB"
                    android:textSize="10sp"
                    android:textColor="#8a9baa"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#c8d4de"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="#ffffff">

        <LinearLayout
            android:id="@+id/navScan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <TextView
                android:id="@+id/navScanIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⬡"
                android:textSize="20sp"
                android:textColor="#0066cc"
                android:gravity="center"/>
            <TextView
                android:id="@+id/navScanLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCAN"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#0066cc"
                android:fontFamily="monospace"
                android:gravity="center"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navQuarantine"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <TextView
                android:id="@+id/navQuarantineIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☣"
                android:textSize="20sp"
                android:textColor="#8a9baa"
                android:gravity="center"/>
            <TextView
                android:id="@+id/navQuarantineLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUARANTINE"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#8a9baa"
                android:fontFamily="monospace"
                android:gravity="center"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <TextView
                android:id="@+id/navSettingsIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙"
                android:textSize="20sp"
                android:textColor="#8a9baa"
                android:gravity="center"/>
            <TextView
                android:id="@+id/navSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SETTINGS"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#8a9baa"
                android:fontFamily="monospace"
                android:gravity="center"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
